// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Shop {
  id         Int         @id @default(autoincrement()) @map("shop_id")
  name       String
  address    String?
  phone      String?
  email      String?
  users      ShopUser[]
  customers  Customer[]
  workOrders WorkOrder[]
  parts      Part[]
  services   Service[]
  nextEmployeeNumber Int @default(1001) @map("next_employee_number")
  // sales tax used by estimates and invoices (0.0825 = 8.25%)
  taxRate            Decimal @default(0.0825) @map("tax_rate") @db.Decimal(6, 4)

  @@map("shop")
}

model User {
  id      Int        @id @default(autoincrement()) @map("user_id")
  name    String
  pinHash String     @map("pin_hash")
  shops   ShopUser[]

  assignedWorkOrders WorkOrder[] @relation("WorkOrderAssignedTechnician")

  @@map("user")
}

model ShopUser {
  shopId       Int    @map("shop_id")
  userId       Int    @map("user_id")
  role         String
  employeeCode Int @map("employee_code")
  // deactivated staff cannot log in or be assigned work (FR-25)
  active       Boolean @default(true)

  shop Shop @relation(fields: [shopId], references: [id])
  user User @relation(fields: [userId], references: [id])

  createdWorkOrders WorkOrder[] @relation("WorkOrderCreator")

  @@id([shopId, userId])
  @@unique([shopId, employeeCode])
  @@map("shop_user")
}

model Customer {
  id                     Int     @id @default(autoincrement()) @map("customer_id")
  shopId                 Int     @map("shop_id")
  name                   String
  phone                  String?
  email                  String?

  shop       Shop              @relation(fields: [shopId], references: [id])
  vehicles   CustomerVehicle[]
  workOrders WorkOrder[]

  @@unique([id, shopId])
  @@index([shopId])
  @@map("customer")
}

model Vehicle {
  id    Int    @id @default(autoincrement()) @map("vehicle_id")
  vin   String @unique
  make  String
  model String
  year  Int

  customers  CustomerVehicle[]
  workOrders WorkOrder[]

  @@map("vehicle")
}

model CustomerVehicle {
  customerId Int @map("customer_id")
  vehicleId  Int @map("vehicle_id")

  customer Customer @relation(fields: [customerId], references: [id])
  vehicle  Vehicle  @relation(fields: [vehicleId], references: [id])

  workOrders WorkOrder[]

  @@id([customerId, vehicleId])
  @@index([vehicleId])
  @@map("customer_vehicle")
}

model WorkOrder {
  id                 Int       @id @default(autoincrement()) @map("work_order_id")
  shopId             Int       @map("shop_id")
  customerId         Int       @map("customer_id")
  vehicleId          Int       @map("vehicle_id")
  createdBy          Int       @map("created_by")
  assignedTechnician Int?      @map("assigned_technician")
  status             String
  createdAt          DateTime  @default(now()) @map("created_at")
  completedAt        DateTime? @map("completed_at")
  mileageIn          Int?      @map("mileage_in")
  customerComplaint  String?   @map("customer_complaint")
  diagnosis          String?
  notes              String?
  conditionNotes     String?   @map("condition_notes")

  statusHistory StatusHistory[]
  approvals     Approval[]
  invoice       Invoice?
  notifications NotificationLog[]

  shop Shop @relation(fields: [shopId], references: [id])

  // Customer must belong to the same shop as the work order
  customer Customer @relation(fields: [customerId, shopId], references: [id, shopId])

  // Vehicle must be linked to that customer
  customerVehicle CustomerVehicle @relation(fields: [customerId, vehicleId], references: [customerId, vehicleId])

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  // Creator must be a member of this shop
  creator ShopUser @relation("WorkOrderCreator", fields: [shopId, createdBy], references: [shopId, userId])

  // Technician: plain FK (Prisma can't do an optional composite). Check shop membership in the route handler.
  technician User? @relation("WorkOrderAssignedTechnician", fields: [assignedTechnician], references: [id])

  parts    WorkOrderPart[]
  services WorkOrderService[]

  @@unique([id, shopId])
  @@index([shopId, status])
  @@index([shopId, createdAt])
  @@index([customerId])
  @@index([vehicleId])
  @@index([assignedTechnician])
  @@map("work_order")
}

model Part {
  id              Int     @id @default(autoincrement()) @map("part_id")
  shopId          Int     @map("shop_id")
  partNumber      String  @map("part_number")
  name            String
  description     String?
  price           Decimal @db.Decimal(10, 2)
  quantityInStock Int     @default(0) @map("quantity_in_stock")

  shop       Shop            @relation(fields: [shopId], references: [id])
  workOrders WorkOrderPart[]

  @@unique([id, shopId])
  @@unique([shopId, partNumber])
  @@index([shopId])
  @@map("part")
}

model WorkOrderPart {
  workOrderId Int     @map("work_order_id")
  partId      Int     @map("part_id")
  shopId      Int     @map("shop_id")
  quantity    Int
  unitPrice   Decimal @map("unit_price") @db.Decimal(10, 2)

  // Work order and part must both belong to the same shop
  workOrder WorkOrder @relation(fields: [workOrderId, shopId], references: [id, shopId])
  part      Part      @relation(fields: [partId, shopId], references: [id, shopId])

  @@id([workOrderId, partId])
  @@index([partId])
  @@index([shopId])
  @@map("work_order_part")
}

model Service {
  id           Int     @id @default(autoincrement()) @map("service_id")
  shopId       Int     @map("shop_id")
  name         String
  description  String?
  defaultPrice Decimal @map("default_price") @db.Decimal(10, 2)

  shop       Shop               @relation(fields: [shopId], references: [id])
  workOrders WorkOrderService[]

  @@unique([id, shopId])
  @@unique([shopId, name])
  @@index([shopId])
  @@map("service")
}

model WorkOrderService {
  workOrderId Int     @map("work_order_id")
  serviceId   Int     @map("service_id")
  shopId      Int     @map("shop_id")
  price       Decimal @db.Decimal(10, 2)
  notes       String?
  approved    Boolean @default(false)
  progress    String  @default("not_started")

  workOrder WorkOrder @relation(fields: [workOrderId, shopId], references: [id, shopId])
  service   Service   @relation(fields: [serviceId, shopId], references: [id, shopId])

  @@id([workOrderId, serviceId])
  @@index([serviceId])
  @@index([shopId])
  @@map("work_order_service")
}

// every status change and technician reassignment; insert-only (FR-13, NFR-08)
model StatusHistory {
  id          Int      @id @default(autoincrement()) @map("status_history_id")
  workOrderId Int      @map("work_order_id")
  shopId      Int      @map("shop_id")
  fromStatus  String?  @map("from_status")
  toStatus    String   @map("to_status")
  changedBy   Int      @map("changed_by")
  changedAt   DateTime @default(now()) @map("changed_at")
  note        String?

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id])

  @@index([workOrderId])
  @@map("status_history")
}

// customer approval or decline decision (FR-10, FR-12); insert-only
model Approval {
  id            Int      @id @default(autoincrement()) @map("approval_id")
  workOrderId   Int      @map("work_order_id")
  shopId        Int      @map("shop_id")
  decision      String   // approved | declined
  method        String   // in_person | phone | sms | email
  approvedTotal Decimal  @map("approved_total") @db.Decimal(10, 2)
  recordedBy    Int      @map("recorded_by")
  recordedAt    DateTime @default(now()) @map("recorded_at")
  note          String?

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id])

  @@index([workOrderId])
  @@map("approval")
}

// invoice built from completed labor and parts actually used (FR-18, FR-19)
model Invoice {
  id            Int       @id @default(autoincrement()) @map("invoice_id")
  workOrderId   Int       @unique @map("work_order_id")
  shopId        Int       @map("shop_id")
  lines         Json
  subtotal      Decimal   @db.Decimal(10, 2)
  taxRate       Decimal   @map("tax_rate") @db.Decimal(6, 4)
  tax           Decimal   @db.Decimal(10, 2)
  total         Decimal   @db.Decimal(10, 2)
  paymentStatus String    @default("unpaid") @map("payment_status")
  paymentMethod String?   @map("payment_method")
  paidAt        DateTime? @map("paid_at")
  createdBy     Int       @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at")

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id])

  @@index([shopId])
  @@map("invoice")
}

// one row per customer notification attempt (FR-22, FR-23)
model NotificationLog {
  id          Int      @id @default(autoincrement()) @map("notification_id")
  shopId      Int      @map("shop_id")
  workOrderId Int?     @map("work_order_id")
  customerId  Int      @map("customer_id")
  event       String
  channel     String   // sms | email | phone | none
  recipient   String?
  result      String   // sent | logged | failed | skipped
  detail      String?
  sentAt      DateTime @default(now()) @map("sent_at")

  workOrder WorkOrder? @relation(fields: [workOrderId], references: [id])

  @@index([shopId, sentAt])
  @@index([workOrderId])
  @@map("notification_log")
}

// who created, updated or approved what (FR-26); insert-only
model AuditLog {
  id         Int      @id @default(autoincrement()) @map("audit_id")
  shopId     Int      @map("shop_id")
  userId     Int      @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   Int?     @map("entity_id")
  details    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([shopId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_log")
}
