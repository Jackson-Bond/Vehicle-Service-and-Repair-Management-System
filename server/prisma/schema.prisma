// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Shop {
  id        Int        @id @default(autoincrement()) @map("shop_id")
  name      String
  address   String?
  phone     String?
  email     String?
  users     ShopUser[]
  customers Customer[]

  @@map("shop")
}

model User {
  id      Int        @id @default(autoincrement()) @map("user_id")
  name    String
  pinHash String     @map("pin_hash")
  shops   ShopUser[]

  createdWorkOrders  WorkOrder[] @relation("WorkOrderCreatedBy")
  assignedWorkOrders WorkOrder[] @relation("WorkOrderAssignedTechnician")

  @@map("user")
}

model ShopUser {
  shopId Int    @map("shop_id")
  userId Int    @map("user_id")
  role   String

  shop Shop @relation(fields: [shopId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@id([shopId, userId])
  @@map("shop_user")
}

model Customer {
  id                      Int      @id @default(autoincrement()) @map("customer_id")
  shopId                  Int      @map("shop_id")
  name                    String
  phone                   String?
  email                   String?
  preferredContactMethod  String?  @map("preferred_contact_method")

  shop       Shop              @relation(fields: [shopId], references: [id])
  vehicles   CustomerVehicle[]
  workOrders WorkOrder[]

  @@map("customer")
}

model Vehicle {
  id    Int    @id @default(autoincrement()) @map("vehicle_id")
  vin   String @unique
  make  String
  model String
  year  Int

  customers  CustomerVehicle[]
  workOrders WorkOrder[]

  @@map("vehicle")
}

model CustomerVehicle {
  customerId Int @map("customer_id")
  vehicleId  Int @map("vehicle_id")

  customer Customer @relation(fields: [customerId], references: [id])
  vehicle  Vehicle  @relation(fields: [vehicleId], references: [id])

  @@id([customerId, vehicleId])
  @@map("customer_vehicle")
}

model WorkOrder {
  id                    Int       @id @default(autoincrement()) @map("work_order_id")
  customerId            Int       @map("customer_id")
  vehicleId             Int       @map("vehicle_id")
  createdBy             Int       @map("created_by")
  assignedTechnician    Int?      @map("assigned_technician")
  status                String
  createdAt             DateTime  @default(now()) @map("created_at")
  completedAt           DateTime? @map("completed_at")
  mileageIn             Int?      @map("mileage_in")
  customerComplaint     String?   @map("customer_complaint")
  diagnosis             String?
  notes                 String?

  customer         Customer            @relation(fields: [customerId], references: [id])
  vehicle          Vehicle             @relation(fields: [vehicleId], references: [id])
  createdByUser    User                @relation("WorkOrderCreatedBy", fields: [createdBy], references: [id])
  technician       User?               @relation("WorkOrderAssignedTechnician", fields: [assignedTechnician], references: [id])
  parts            WorkOrderPart[]
  services         WorkOrderService[]

  @@map("work_order")
}

model Part {
  id                Int    @id @default(autoincrement()) @map("part_id")
  partNumber        String @map("part_number")
  name              String
  description       String?
  price             Decimal @db.Decimal(10, 2)
  quantityInStock   Int     @default(0) @map("quantity_in_stock")

  workOrders WorkOrderPart[]

  @@map("part")
}

model WorkOrderPart {
  workOrderId Int     @map("work_order_id")
  partId      Int     @map("part_id")
  quantity    Int
  unitPrice   Decimal @db.Decimal(10, 2) @map("unit_price")

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id])
  part      Part      @relation(fields: [partId], references: [id])

  @@id([workOrderId, partId])
  @@map("work_order_part")
}

model Service {
  id           Int     @id @default(autoincrement()) @map("service_id")
  name         String
  description  String?
  defaultPrice Decimal @db.Decimal(10, 2) @map("default_price")

  workOrders WorkOrderService[]

  @@map("service")
}

model WorkOrderService {
  workOrderId Int     @map("work_order_id")
  serviceId   Int     @map("service_id")
  price       Decimal @db.Decimal(10, 2)
  notes       String?

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id])
  service   Service   @relation(fields: [serviceId], references: [id])

  @@id([workOrderId, serviceId])
  @@map("work_order_service")
}

